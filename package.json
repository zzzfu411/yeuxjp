{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint src scripts tests",
    "test": "node --test tests/unit/*.test.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "npm run validate:data && npm run lint && npm run test && npm run build && npm run e2e",
    "check:release": "npm run check && npm run e2e:browser:required && npm run e2e:pwa:required",
    "e2e": "node tests/e2e/smoke.mjs",
    "e2e:install": "playwright install chromium",
    "e2e:install:ci": "playwright install --with-deps chromium",
    "e2e:browser": "node tests/e2e/browser.mjs",
    "e2e:browser:required": "node tests/e2e/browser.mjs --required",
    "e2e:pwa": "node tests/e2e/pwa-offline.mjs",
    "e2e:pwa:required": "node tests/e2e/pwa-offline.mjs --required"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
